{
  "name": "nombres-de-rama",
  "target": "branch",
  "enforcement": "active",
  "conditions": {
    "ref_name": {
      "include": ["~ALL"],
      "exclude": [
        "refs/heads/main",
        "refs/heads/staging",
        "refs/heads/feat/*",
        "refs/heads/fix/*",
        "refs/heads/docs/*",
        "refs/heads/style/*",
        "refs/heads/refactor/*",
        "refs/heads/perf/*",
        "refs/heads/test/*",
        "refs/heads/build/*",
        "refs/heads/ci/*",
        "refs/heads/chore/*",
        "refs/heads/revert/*",
        "refs/heads/hotfix/*",
        "refs/heads/dependabot/**"
      ]
    }
  },
  "bypass_actors": [
    {
      "actor_id": 5,
      "actor_type": "RepositoryRole",
      "bypass_mode": "always"
    }
  ],
  "rules": [{ "type": "creation" }]
}
