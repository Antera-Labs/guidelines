        <mxCell id="DR-04-trace-card" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fffbeb;strokeColor=#d97706;fontColor=#0f172a;fontSize=11;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;strokeWidth=1.5;" value="&lt;b&gt;Trazabilidad Paso a Paso del Caso de Uso CU-04 (4. Decisión Crediticia):&lt;/b&gt;&lt;br&gt;• &lt;b&gt;Paso 1 (Automático):&lt;/b&gt; MotorMatrizDecisionBDDictamenes ejecuta automáticamente cruce score vs. monto, política de riesgo y dictamen automático y entrega a AnalistaCredito  [&lt;i&gt;Borde:&lt;/i&gt; &lt;code&gt;GatewayMotorMatrizDecision / VistaDictamenMatriz&lt;/code&gt; → &lt;i&gt;Control:&lt;/i&gt; &lt;code&gt;ControladorMatrizDecision&lt;/code&gt; → &lt;i&gt;Entidad:&lt;/i&gt; &lt;code&gt;EvaluacionMatrizDecision&lt;/code&gt;]&lt;br&gt;• &lt;b&gt;Paso 2-4:&lt;/b&gt; AnalistaCredito deriva casos en zona gris o montos altos a ComiteCredito, quien registra el fallo en BDResolucionesActasComite y confirma autorización  [&lt;i&gt;Borde:&lt;/i&gt; &lt;code&gt;VistaRevisionComiteCredito / GatewayBDResolucionesComite&lt;/code&gt; → &lt;i&gt;Control:&lt;/i&gt; &lt;code&gt;ControladorRevisionComite&lt;/code&gt; → &lt;i&gt;Entidad:&lt;/i&gt; &lt;code&gt;RevisionManualComite&lt;/code&gt;]&lt;br&gt;• &lt;b&gt;Paso 5-6:&lt;/b&gt; AnalistaCredito define tasa según riesgo, plazo, cupo aprobado y garantías requeridas en BDTarifarioCondiciones  [&lt;i&gt;Borde:&lt;/i&gt; &lt;code&gt;VistaCondicionesCrediticias / GatewayBDTarifarioCondiciones&lt;/code&gt; → &lt;i&gt;Control:&lt;/i&gt; &lt;code&gt;ControladorCondicionesCrediticias&lt;/code&gt; → &lt;i&gt;Entidad:&lt;/i&gt; &lt;code&gt;DefinicionCondicionesCrediticias&lt;/code&gt;]" vertex="1">
          <mxGeometry height="140" width="1960" x="40" y="1110" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
