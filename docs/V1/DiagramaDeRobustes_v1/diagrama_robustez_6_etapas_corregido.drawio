        <mxCell id="DR-03-edge-14" edge="1" parent="1" source="DR-03-ctrl1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#0f766e;strokeWidth=1.6;fontSize=10;fontColor=#0f172a;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;" target="DR-03-b_sys1" value="2: procesa cálculo financiero">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="DR-03-edge-15" edge="1" parent="1" source="DR-03-ctrl2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#0f766e;strokeWidth=1.6;fontSize=10;fontColor=#0f172a;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;" target="DR-03-b_sys2" value="3: invoca inferencia LLM y RAG">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="DR-03-edge-16" edge="1" parent="1" source="DR-03-ctrl3" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#0f766e;strokeWidth=1.6;fontSize=10;fontColor=#0f172a;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;" target="DR-03-b_sys3" value="4: ejecuta segmentación y persiste">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="DR-03-edge-17" edge="1" parent="1" source="DR-03-sa0" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#0f766e;strokeWidth=1.6;fontSize=10;fontColor=#0f172a;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;" target="DR-03-b_sys0" value="Motor Reglas y BD Políticas">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="DR-03-edge-18" edge="1" parent="1" source="DR-03-b_sys1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#0f766e;strokeWidth=1.6;fontSize=10;fontColor=#0f172a;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;" target="DR-03-sa1" value="Motor Financiero Capacidad">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="DR-03-edge-19" edge="1" parent="1" source="DR-03-b_sys2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#0f766e;strokeWidth=1.6;fontSize=10;fontColor=#0f172a;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;" target="DR-03-sa2" value="Motor Scoring Automático LLM y RAG">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="DR-03-edge-20" edge="1" parent="1" source="DR-03-b_sys3" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#0f766e;strokeWidth=1.6;fontSize=10;fontColor=#0f172a;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;" target="DR-03-sa3" value="Motor Segmentación y BD Riesgo">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="DR-03-trace-card" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fffbeb;strokeColor=#d97706;fontColor=#0f172a;fontSize=11;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;strokeWidth=1.5;" value="&lt;b&gt;Trazabilidad Paso a Paso del Caso de Uso CU-03 (3. Evaluación y Cálculo del Score (LLM y RAG)):&lt;/b&gt;&lt;br&gt;• &lt;b&gt;Paso 1 (Automático):&lt;/b&gt; MotorReglasPoliticas inicia y ejecuta automáticamente filtros de política (edad, mora vigente, sobreendeudamiento) y encadena a capacidad de pago  [&lt;i&gt;Borde:&lt;/i&gt; &lt;code&gt;GatewayMotorReglasPoliticas / VistaMonitorFiltrosYCapacidad&lt;/code&gt; → &lt;i&gt;Control:&lt;/i&gt; &lt;code&gt;ControladorFiltrosPolitica&lt;/code&gt; → &lt;i&gt;Entidad:&lt;/i&gt; &lt;code&gt;FiltroPolitica&lt;/code&gt;]&lt;br&gt;• &lt;b&gt;Paso 2 (Automático):&lt;/b&gt; MotorFinancieroCapacidad calcula automáticamente ratio cuota/ingreso, nivel de endeudamiento y flujo de caja disponible y envía a MotorScoringLLMRAG  [&lt;i&gt;Borde:&lt;/i&gt; &lt;code&gt;GatewayMotorFinancieroCapacidad / VistaMonitorFiltrosYCapacidad&lt;/code&gt; → &lt;i&gt;Control:&lt;/i&gt; &lt;code&gt;ControladorCapacidadPago&lt;/code&gt; → &lt;i&gt;Entidad:&lt;/i&gt; &lt;code&gt;AnalisisCapacidadDePago&lt;/code&gt;]&lt;br&gt;• &lt;b&gt;Paso 3 (Automático LLM+RAG):&lt;/b&gt; MotorScoringLLMRAG ejecuta automáticamente inferencia mediante LLM y RAG, cálculo de PD y transformación a Score y transfiere a MotorSegmentacionRiesgo  [&lt;i&gt;Borde:&lt;/i&gt; &lt;code&gt;GatewayMotorScoringLLMRAG / VistaSupervisionScoreLLMRAG&lt;/code&gt; → &lt;i&gt;Control:&lt;/i&gt; &lt;code&gt;ControladorScoringLLMRAG&lt;/code&gt; → &lt;i&gt;Entidad:&lt;/i&gt; &lt;code&gt;AplicacionModeloScoring&lt;/code&gt;]&lt;br&gt;• &lt;b&gt;Paso 4 (Automático):&lt;/b&gt; MotorSegmentacionRiesgo evalúa automáticamente puntos de corte (cut-offs), asigna categoría (A, B, C, D, E) y entrega resultado a AnalistaRiesgoCrediticio  [&lt;i&gt;Borde:&lt;/i&gt; &lt;code&gt;GatewayMotorSegmentacionRiesgo / VistaSupervisionScoreLLMRAG&lt;/code&gt; → &lt;i&gt;Control:&lt;/i&gt; &lt;code&gt;ControladorSegmentacionRiesgo&lt;/code&gt; → &lt;i&gt;Entidad:&lt;/i&gt; &lt;code&gt;SegmentacionRiesgoCrediticio&lt;/code&gt;]" vertex="1">
          <mxGeometry height="140" width="1960" x="40" y="1110" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
