        <mxCell id="DR-05-trace-card" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fffbeb;strokeColor=#d97706;fontColor=#0f172a;fontSize=11;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;strokeWidth=1.5;" value="&lt;b&gt;Trazabilidad Paso a Paso del Caso de Uso CU-05 (5. Formalización y Desembolso):&lt;/b&gt;&lt;br&gt;• &lt;b&gt;Paso 1-3:&lt;/b&gt; ClienteSolicitante y OficialOperaciones registran firma de contrato/pagaré y constitución de garantías en SistemaContratosBDGarantias, habilitando el desembolso  [&lt;i&gt;Borde:&lt;/i&gt; &lt;code&gt;VistaFormalizacionContratos / GatewaySistemaContratosGarantias&lt;/code&gt; → &lt;i&gt;Control:&lt;/i&gt; &lt;code&gt;ControladorAceptacionCliente&lt;/code&gt; → &lt;i&gt;Entidad:&lt;/i&gt; &lt;code&gt;GestionAceptacionCliente&lt;/code&gt;]&lt;br&gt;• &lt;b&gt;Paso 4-5:&lt;/b&gt; OficialOperaciones autoriza el desembolso en CoreBancarioCuentasCartera, que ejecuta automáticamente la acreditación de fondos y tabla de amortización para ClienteSolicitante  [&lt;i&gt;Borde:&lt;/i&gt; &lt;code&gt;VistaEjecucionDesembolso / GatewayCoreCuentasCartera&lt;/code&gt; → &lt;i&gt;Control:&lt;/i&gt; &lt;code&gt;ControladorDesembolsoCredito&lt;/code&gt; → &lt;i&gt;Entidad:&lt;/i&gt; &lt;code&gt;EjecucionDesembolsoCredito&lt;/code&gt;]" vertex="1">
          <mxGeometry height="140" width="1960" x="40" y="1110" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
