        <mxCell id="DR-02-edge-16" edge="1" parent="1" source="DR-02-b_sys2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#0f766e;strokeWidth=1.6;fontSize=10;fontColor=#0f172a;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;" target="DR-02-sa2" value="Pipeline Consolidación BD">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="DR-02-trace-card" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fffbeb;strokeColor=#d97706;fontColor=#0f172a;fontSize=11;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;strokeWidth=1.5;" value="&lt;b&gt;Trazabilidad Paso a Paso del Caso de Uso CU-02 (2. Recolección y Consolidación de Datos):&lt;/b&gt;&lt;br&gt;• &lt;b&gt;Paso 1-2:&lt;/b&gt; AnalistaCreditoDatos solicita recolectar datos internos (historial, saldos y comportamiento) en CoreBancarioDatosInternos  [&lt;i&gt;Borde:&lt;/i&gt; &lt;code&gt;VistaConsultaDatosInternos / GatewayCoreDatosInternos&lt;/code&gt; → &lt;i&gt;Control:&lt;/i&gt; &lt;code&gt;ControladorRecoleccionInterna&lt;/code&gt; → &lt;i&gt;Entidad:&lt;/i&gt; &lt;code&gt;RecoleccionDatosInternos&lt;/code&gt;]&lt;br&gt;• &lt;b&gt;Paso 3-4:&lt;/b&gt; AnalistaCreditoDatos ejecuta consulta a buró de crédito y central de riesgos (SB/SEPS) y transfiere al MotorIntegracionDatos  [&lt;i&gt;Borde:&lt;/i&gt; &lt;code&gt;VistaConsultaBuroExterno / GatewayBuroSBSEPS&lt;/code&gt; → &lt;i&gt;Control:&lt;/i&gt; &lt;code&gt;ControladorConsultaExterna&lt;/code&gt; → &lt;i&gt;Entidad:&lt;/i&gt; &lt;code&gt;ConsultaDatosExternos&lt;/code&gt;]&lt;br&gt;• &lt;b&gt;Paso 5:&lt;/b&gt; MotorIntegracionDatos ejecuta automáticamente depuración, imputación de faltantes y normalización y entrega a AnalistaCreditoDatos  [&lt;i&gt;Borde:&lt;/i&gt; &lt;code&gt;GatewayMotorIntegracion / VistaConsolidacionDatos&lt;/code&gt; → &lt;i&gt;Control:&lt;/i&gt; &lt;code&gt;ControladorIntegracionYLimpieza&lt;/code&gt; → &lt;i&gt;Entidad:&lt;/i&gt; &lt;code&gt;IntegracionYLimpiezaDatos&lt;/code&gt;]" vertex="1">
          <mxGeometry height="140" width="1960" x="40" y="1110" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
