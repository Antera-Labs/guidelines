        <mxCell id="DR-06-trace-card" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fffbeb;strokeColor=#d97706;fontColor=#0f172a;fontSize=11;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;strokeWidth=1.5;" value="&lt;b&gt;Trazabilidad Paso a Paso del Caso de Uso CU-06 (6. Seguimiento y Cobranza):&lt;/b&gt;&lt;br&gt;• &lt;b&gt;Paso 1-2:&lt;/b&gt; BDMonitoreoCarteraAlertas ejecuta automáticamente score de comportamiento y alertas tempranas, y AnalistaCarteraRiesgos asigna casos a GestorCobranza  [&lt;i&gt;Borde:&lt;/i&gt; &lt;code&gt;GatewayMotorMonitoreoAlertas / VistaMonitoreoCarteraAlertas&lt;/code&gt; → &lt;i&gt;Control:&lt;/i&gt; &lt;code&gt;ControladorMonitoreoCartera&lt;/code&gt; → &lt;i&gt;Entidad:&lt;/i&gt; &lt;code&gt;MonitoreoCarteraActiva&lt;/code&gt;]&lt;br&gt;• &lt;b&gt;Paso 3-4:&lt;/b&gt; GestorCobranza ejecuta cobranza preventiva, temprana y judicial en SistemaCobranzaClienteDeudor y transfiere estado actualizado a contabilidad  [&lt;i&gt;Borde:&lt;/i&gt; &lt;code&gt;VistaGestionCobranza / GatewaySistemaCobranzaDeudor&lt;/code&gt; → &lt;i&gt;Control:&lt;/i&gt; &lt;code&gt;ControladorGestionCobranza&lt;/code&gt; → &lt;i&gt;Entidad:&lt;/i&gt; &lt;code&gt;EjecucionGestionCobranza&lt;/code&gt;]&lt;br&gt;• &lt;b&gt;Paso 5 (Automático):&lt;/b&gt; SistemaContableBDProvisiones calcula automáticamente parámetros PD, LGD y EAD y pérdida esperada (PD×LGD×EAD) y entrega reporte a AnalistaCarteraRiesgos  [&lt;i&gt;Borde:&lt;/i&gt; &lt;code&gt;GatewaySistemaContableProvisiones / VistaReporteProvisionesContables&lt;/code&gt; → &lt;i&gt;Control:&lt;/i&gt; &lt;code&gt;ControladorCalculoProvisiones&lt;/code&gt; → &lt;i&gt;Entidad:&lt;/i&gt; &lt;code&gt;CalculoProvisionesContables&lt;/code&gt;]" vertex="1">
          <mxGeometry height="140" width="1960" x="40" y="1110" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
