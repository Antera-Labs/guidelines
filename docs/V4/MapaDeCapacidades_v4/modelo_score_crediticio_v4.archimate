<?xml version="1.0" encoding="UTF-8"?>
<archimate:model xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:archimate="http://www.archimatetool.com/archimate" name="Mapa de Capacidades y Flujo de Valor — Proceso Crediticio Cooperativa (Consulta AVAL)" id="id-model-7dc0911fb7b046a4874bc4f8dfd4f348" version="5.0.0">
  <folder name="Strategy" id="id-folder-797733b5aa1f4926a9f5c426f7739759" type="strategy">
    <element xsi:type="archimate:ValueStream" name="1. Solicitud y captación" id="id-vs-m-6245e3e228034578b9a9f8fd429ecf48">
      <documentation>Fase inicial de originación crediticia: recepción de la solicitud, validación KYC/PLA-FT y conformación del expediente digital.</documentation>
    </element>
    <element xsi:type="archimate:ValueStream" name="1.1 Recepción de solicitud" id="id-vs-c-2250ace556ce488983ff92e784531833">
      <documentation>Subfase 1.1 Recepción de solicitud | Actividades: Registro de datos del cliente, Definición de monto y plazo, Registro de destino del crédito | Entregable: Solicitud registrada</documentation>
    </element>
    <element xsi:type="archimate:Capability" name="F1.1 Recepción y Registro Centralizado de Solicitud" id="id-cap-f-00e10df0edc7452a8cfa29a01d2f7860"/>
    <element xsi:type="archimate:Capability" name="✓ Registro centralizado del socio (atención simultánea)" id="id-cap-act-730760cf12a043d2b205252efa140cfa"/>
    <element xsi:type="archimate:Capability" name="✓ Selección de línea (consumo / vivienda), monto y plazo" id="id-cap-act-5144f5f7f8694654986d780acfb45595"/>
    <element xsi:type="archimate:Capability" name="✓ Validación de presupuesto de línea y destino del crédito" id="id-cap-act-bb16019025de47aca6de61855d9186a0"/>
    <element xsi:type="archimate:ValueStream" name="1.2 Validación de identidad (KYC)" id="id-vs-c-bc3b394aef334596848ded7f6cce436a">
      <documentation>Subfase 1.2 Validación de identidad (KYC) | Actividades: Verificación de cédula de identidad, Validación biométrica del solicitante, Consulta en listas restrictivas (PLA/FT) | Entregable: Cliente validado</documentation>
    </element>
    <element xsi:type="archimate:Capability" name="F1.2 Validación de Identidad y Autorización AVAL" id="id-cap-f-4cfa1c4bc9074e5aa3bc99f0c9aaecec"/>
    <element xsi:type="archimate:Capability" name="✓ Verificación de cédula de identidad del socio" id="id-cap-act-801ba336befa4d25b9b356af82880323"/>
    <element xsi:type="archimate:Capability" name="✓ Validación biométrica y autorización de consulta AVAL" id="id-cap-act-c7dd037f3a554def923044d7b0ba2831"/>
    <element xsi:type="archimate:Capability" name="✓ Consulta en listas restrictivas y control (PLA/FT)" id="id-cap-act-e3e46d5393874bc29a3b31731a2a66bc"/>
    <element xsi:type="archimate:ValueStream" name="1.3 Recolección documental" id="id-vs-c-5d04de6a3f0a4002862c54d7546f3596">
      <documentation>Subfase 1.3 Recolección documental | Actividades: Recolección de ingresos y roles de pago, Recepción de declaraciones tributarias, Registro de respaldos y garantías | Entregable: Expediente digital</documentation>
    </element>
    <element xsi:type="archimate:Capability" name="F1.3 Simplificación y Digitalización Documental" id="id-cap-f-d4b32a9601a54525ab76a04cedc14937"/>
    <element xsi:type="archimate:Capability" name="✓ Recolección de justificación de ingresos y roles de pago" id="id-cap-act-954d55e6fad84de9a476881081404601"/>
    <element xsi:type="archimate:Capability" name="✓ Unificación de declaraciones y seguros (reducción de 14 docs)" id="id-cap-act-34aedd479c9849f7baf3db75e797c6e5"/>
    <element xsi:type="archimate:Capability" name="✓ Registro digital de respaldos y garantías" id="id-cap-act-fec608d88fb0484d9877f5c23868c633"/>
    <element xsi:type="archimate:ValueStream" name="2. Recolección y consolidación de datos" id="id-vs-m-12e389bda3d64cf8af337d0ff6e456f5">
      <documentation>Integración de fuentes internas de la entidad y fuentes externas (buró y central de riesgos SB/SEPS) en un dataset depurado.</documentation>
    </element>
    <element xsi:type="archimate:ValueStream" name="2.1 Validación de Datos internos" id="id-vs-c-7c6bb75b202c42f584a36cc9dd4dd77d">
      <documentation>Subfase 2.1 Datos internos | Actividades: Consulta de historial con la entidad, Evaluación de saldos y ahorros, Análisis de comportamiento de pago interno | Entregable: Perfil interno</documentation>
    </element>
    <element xsi:type="archimate:Capability" name="F2.1 Extracción de Datos Internos de la Cooperativa" id="id-cap-f-240af738c09640968b5c1574a4cbc9a3"/>
    <element xsi:type="archimate:Capability" name="✓ Consulta de historial crediticio con la entidad" id="id-cap-act-e33466cdf3ef424691a0fe2ed3a6e390"/>
    <element xsi:type="archimate:Capability" name="✓ Evaluación de saldos, encaje y ahorros del socio" id="id-cap-act-ec8f4255daf347a4b068d179a40fd95f"/>
    <element xsi:type="archimate:Capability" name="✓ Análisis de comportamiento de pago y días de vencimiento" id="id-cap-act-4da6586d4652437ca9345502d410e949"/>
    <element xsi:type="archimate:ValueStream" name="2.2 Validación de Datos externos (AVAL)" id="id-vs-c-3353f6f79e84446d8c9d4598f41a0882">
      <documentation>Subfase 2.2 Datos externos | Actividades: Consulta a buró de crédito, Consulta a central de riesgos (SB/SEPS) | Entregable: Reporte de buró</documentation>
    </element>
    <element xsi:type="archimate:Capability" name="F2.2 Consulta a Buró AVAL y Central de Riesgos" id="id-cap-f-c9953c75b6ac4892aa03aa1ed3d63481"/>
    <element xsi:type="archimate:Capability" name="✓ Consulta de score y reporte crediticio en Buró AVAL" id="id-cap-act-a7e6ecb6217e47d9b363b2ea2e8a0a16"/>
    <element xsi:type="archimate:Capability" name="✓ Consulta de endeudamiento y central de riesgos (SB/SEPS)" id="id-cap-act-e5fbbc269ba049b5aab42d6c492e85ce"/>
    <element xsi:type="archimate:ValueStream" name="2.3 Centralización y limpieza" id="id-vs-c-2cf7d7624a844f149a54a52d93bddc94">
      <documentation>Subfase 2.3 Integración y limpieza | Actividades: Depuración de registros e inconsistencias, Imputación de valores faltantes, Normalización y estandarización de variables | Entregable: Dataset consolidado</documentation>
    </element>
    <element xsi:type="archimate:Capability" name="F2.3 Centralización, Limpieza y Estandarización" id="id-cap-f-97438cdfc08149efb8d90a259e6839a7"/>
    <element xsi:type="archimate:Capability" name="✓ Depuración de registros e inconsistencias (Interno + AVAL)" id="id-cap-act-072377cbc821404c9272826b1c65bd02"/>
    <element xsi:type="archimate:Capability" name="✓ Prevención de pérdida de datos en solicitudes simultáneas" id="id-cap-act-136e595ae3314a55932f97a70550063a"/>
    <element xsi:type="archimate:Capability" name="✓ Normalización de variables para matrices automatizadas" id="id-cap-act-f46c9dd857b242648f631386fb89309b"/>
    <element xsi:type="archimate:ValueStream" name="3. Evaluación y cálculo del score (AVAL)" id="id-vs-m-a7b0bcb66c974e22a34d1bf541ae8dce">
      <documentation>Aplicación de filtros de política (knock-out), análisis financiero de capacidad de pago, inferencia del modelo estadístico/ML y segmentación de riesgo.</documentation>
    </element>
    <element xsi:type="archimate:ValueStream" name="3.1 Filtros de política (knock-out)" id="id-vs-c-f2c73997764e48d4a250e224575a9301">
      <documentation>Subfase 3.1 Filtros de política (knock-out) | Actividades: Validación de edad y capacidad mínima, Verificación de mora vigente, Control de umbral de sobreendeudamiento | Entregable: Aprobado / rechazado previo</documentation>
    </element>
    <element xsi:type="archimate:Capability" name="F3.1 Motor de Reglas y Políticas de Negocio" id="id-cap-f-8cd046037b2843f3ab21fd18e36a9069"/>
    <element xsi:type="archimate:Capability" name="✓ Validación de edad, capacidad y vigencia de línea" id="id-cap-act-931ea0c924ee45c69169d12301ddf121"/>
    <element xsi:type="archimate:Capability" name="✓ Verificación de mora vigente y vencimientos en AVAL" id="id-cap-act-a2133744529049099d198c8ff4fe1081"/>
    <element xsi:type="archimate:Capability" name="✓ Control de umbral de sobreendeudamiento del socio" id="id-cap-act-3e27963b0bf34642822fa84ab5be3cb2"/>
    <element xsi:type="archimate:ValueStream" name="3.2 Análisis de capacidad de pago" id="id-vs-c-ba08d3271b7141bdb22cf1e462efc156">
      <documentation>Subfase 3.2 Análisis de capacidad de pago | Actividades: Cálculo de ratio cuota / ingreso, Evaluación de nivel de endeudamiento, Determinación de flujo de caja disponible | Entregable: Indicadores financieros</documentation>
    </element>
    <element xsi:type="archimate:Capability" name="F3.2 Cálculo Automatizado de Indicadores Financieros" id="id-cap-f-8d8ca029fe884b97a3cf178ce2fc61f4"/>
    <element xsi:type="archimate:Capability" name="✓ Cálculo automatizado de ratio cuota / ingreso neto" id="id-cap-act-139a767d13254d8594a3a51c52559a6b"/>
    <element xsi:type="archimate:Capability" name="✓ Evaluación de endeudamiento consolidado (Cooperativa + AVAL)" id="id-cap-act-022f8c58dc254882a6a2f407955c29ef"/>
    <element xsi:type="archimate:Capability" name="✓ Determinación de flujo de caja y liquidez disponible" id="id-cap-act-84d33ea3bc3d47e9964d63f960ab0311"/>
    <element xsi:type="archimate:ValueStream" name="3.3 Segmentación de riesgo (AVAL)" id="id-vs-c-9b553351e334424598622e866af64599">
      <documentation>Subfase 3.4 Segmentación de riesgo | Actividades: Evaluación de puntos de corte (cut-offs), Asignación a categoría de riesgo (A, B, C, D, E) | Entregable: Calificación de riesgo</documentation>
    </element>
    <element xsi:type="archimate:Capability" name="F3.3 Clasificación y Rating de Riesgo (AVAL)" id="id-cap-f-55fe56d7a8f64838be52f1058dffbdd2"/>
    <element xsi:type="archimate:Capability" name="✓ Evaluación de puntos de corte según Score AVAL" id="id-cap-act-51442dd1f5e44a819b33fa8d249e677a"/>
    <element xsi:type="archimate:Capability" name="✓ Asignación de categoría de riesgo (A, B, C, D, E)" id="id-cap-act-d5bd016e934444d893692efa73e3d2e6"/>
    <element xsi:type="archimate:ValueStream" name="4. Decisión crediticia" id="id-vs-m-4c7d7eb0fbe043bcb27256db451166b8">
      <documentation>Determinación del dictamen crediticio mediante matriz automatizada, revisión por comité en zona gris y parametrización de la oferta.</documentation>
    </element>
    <element xsi:type="archimate:ValueStream" name="4.1 Matriz de decisión automatizada" id="id-vs-c-332a43420cef4a93a8948739176e1d8c">
      <documentation>Subfase 4.1 Matriz de decisión | Actividades: Cruce de score vs. monto solicitado, Contrastación contra política de riesgo, Generación de dictamen automático | Entregable: Recomendación</documentation>
    </element>
    <element xsi:type="archimate:Capability" name="F4.1 Evaluación en Matriz de Decisión Automatizada" id="id-cap-f-540db4abdbc242b987f19e8198227731"/>
    <element xsi:type="archimate:Capability" name="✓ Acceso directo de asesores a matriz automatizada (Score AVAL)" id="id-cap-act-f56a4701b416415186a1118edefffbda"/>
    <element xsi:type="archimate:Capability" name="✓ Contrastación contra política de riesgo y presupuesto de línea" id="id-cap-act-2739b4ad2ba74c2e946f1748a48dcb6b"/>
    <element xsi:type="archimate:Capability" name="✓ Generación de dictamen automático sin dependencia externa" id="id-cap-act-a891cae1ff2d48fc90eddef8f824d637"/>
    <element xsi:type="archimate:ValueStream" name="4.2 Revisión manual / comité" id="id-vs-c-2dd16c3a33e14feabaf0f04b759bb275">
      <documentation>Subfase 4.2 Revisión manual / comité | Actividades: Análisis de casos en zona gris, Evaluación y fallo para montos altos | Entregable: Resolución del comité</documentation>
    </element>
    <element xsi:type="archimate:Capability" name="F4.2 Gestión de Comité y Revisión de Crédito" id="id-cap-f-bb11c46e759d494fade51251376983c3"/>
    <element xsi:type="archimate:Capability" name="✓ Análisis de casos en zona gris o excepción de política" id="id-cap-act-101a901916114bd196eeb4ffd073de5f"/>
    <element xsi:type="archimate:Capability" name="✓ Evaluación y fallo de aprobación para montos altos" id="id-cap-act-2b01797c587d4197a47ab746ef3853f3"/>
    <element xsi:type="archimate:ValueStream" name="4.3 Definición de condiciones por línea" id="id-vs-c-fe24b5b4e17d48a187ab77d4af8c2f91">
      <documentation>Subfase 4.3 Definición de condiciones | Actividades: Asignación de tasa de interés según riesgo, Definición de plazo y cupo aprobado, Establecimiento de garantías requeridas | Entregable: Oferta crediticia</documentation>
    </element>
    <element xsi:type="archimate:Capability" name="F4.3 Estructuración de Condiciones por Línea de Crédito" id="id-cap-f-552bd3cc04e9458eadb9b51293dc3b16"/>
    <element xsi:type="archimate:Capability" name="✓ Diferenciación de tasa de interés (consumo vs. vivienda)" id="id-cap-act-4510cc57b7914dfcb610dfa7d5304cf7"/>
    <element xsi:type="archimate:Capability" name="✓ Definición de plazo y cupo aprobado según perfil AVAL" id="id-cap-act-b45d6a676a1d4000976cf83e8ae0dc11"/>
    <element xsi:type="archimate:Capability" name="✓ Establecimiento de garantías y seguros requeridos" id="id-cap-act-92e3bbaeccf44c95bed237fb8c3b5d92"/>
    <element xsi:type="archimate:ValueStream" name="5. Formalización y desembolso" id="id-vs-m-65e44d2994144ce09f76bc1825b1a808">
      <documentation>Control operativo del expediente aprobado, instrumentación y firma de la operación, acreditación de fondos con débito de valores y legalización de la documentación (carga de pagarés).</documentation>
    </element>
    <element xsi:type="archimate:ValueStream" name="5.1 Validación del expediente" id="id-vs-c-08637f98964548c58c8d77e6c109ec14">
      <documentation>Subfase 5.1 Validación del expediente | Actividades: Verificación de aprobación (fábrica / comité), Revisión de la ficha del socio, Control de situación económica y declaraciones | Entregable: Expediente validado</documentation>
    </element>
    <element xsi:type="archimate:Capability" name="F5.1 Control Operativo del Expediente Aprobado" id="id-cap-f-582bd3c4ffb645e3a6627e1396ae145c">
      <documentation>Operaciones revisa (sin modificar) la pantalla &quot;Consulta Trabajo Personas Naturales&quot; del core. Grupos de verificación: Identificación y contacto; Laboral; Situación económica; Obligaciones y referencias; Cumplimiento (PEPS, residencia fiscal, relaciones, Monto Esperado*); Soporte. No rehace el análisis de capacidad de pago (etapa 3). Si hay inconsistencias, devuelve el expediente al asesor antes del desembolso. *Monto Esperado: por confirmar con el área (posible perfil transaccional PLA/FT).</documentation>
    </element>
    <element xsi:type="archimate:Capability" name="✓ Verificación de aprobación (fábrica / comité)" id="id-cap-act-c2966db05d9f4dc0befeec572f9d2b94"/>
    <element xsi:type="archimate:Capability" name="✓ Revisión de la ficha del socio (datos, trabajo, referencias)" id="id-cap-act-f02e13070e174df0bdda5e66f0ad765a"/>
    <element xsi:type="archimate:Capability" name="✓ Control de situación económica y declaraciones (PEPS)" id="id-cap-act-d139f83fb5244e60868c6a7ae756e12f"/>
    <element xsi:type="archimate:ValueStream" name="5.2 Instrumentación y firma" id="id-vs-c-5ddeb091a3bb47ccba260af08fe5a7f8">
      <documentation>Subfase 5.2 Instrumentación y firma | Actividades: Registro de la operación según tipo, Emisión de contrato, pagaré, garantías y tabla de amortización, Firma del socio y validación de firmas | Entregable: Operación firmada</documentation>
    </element>
    <element xsi:type="archimate:Capability" name="F5.2 Instrumentación y Firma de la Operación" id="id-cap-f-31df4646a9f84a5cb612b1bcc142f86e">
      <documentation>Tipos de operación: original, novación, refinanciamiento, reestructuración. Documentos: tabla de amortización, liquidación de valores, seguro de desgravamen, autorización de débito, declaración de vinculación (según el crédito), contrato y pagaré. Notificación al socio por llamada o correo. Errores se corrigen o se reingresan solo antes del desembolso. PENDIENTE: confirmar si los créditos con garantía real (hipotecaria / prendaria) tienen un paso de constitución o inscripción antes del desembolso.</documentation>
    </element>
    <element xsi:type="archimate:Capability" name="✓ Registro de la operación según tipo (original / renovación)" id="id-cap-act-6d1c59857cff4631ba737fac353c83c1"/>
    <element xsi:type="archimate:Capability" name="✓ Emisión de contrato, pagaré, garantías y tabla de amortización" id="id-cap-act-4219a85af67c4eafa18991924c0b342f"/>
    <element xsi:type="archimate:Capability" name="✓ Firma del socio y validación de firmas con cédula" id="id-cap-act-f4244719732547debc1e9d8173acaccc"/>
    <element xsi:type="archimate:ValueStream" name="5.3 Desembolso y legalización" id="id-vs-c-073c35aef36e4d98ae80973d85a1ec97">
      <documentation>Subfase 5.3 Desembolso y legalización | Actividades: Acreditación en cuenta y débito de valores, Verificación del crédito desembolsado, Legalización y carga de pagarés | Entregable: Crédito desembolsado</documentation>
    </element>
    <element xsi:type="archimate:Capability" name="F5.3 Desembolso y Legalización" id="id-cap-f-661bd48ccc5e47debed236b9e63ace1b">
      <documentation>Acreditación en la cuenta del socio con débito automático de valores (desgravamen, etc.); verificación del estado &quot;desembolsado&quot;; legalización por la jefa de agencia; escaneo y carga de pagarés al cierre del día (impacto contable). Después del desembolso no se revisa nada en esta etapa.</documentation>
    </element>
    <element xsi:type="archimate:Capability" name="✓ Acreditación en cuenta y débito de valores (desgravamen)" id="id-cap-act-3d6852fbd8e44d5582a87c1a4f6649bc"/>
    <element xsi:type="archimate:Capability" name="✓ Verificación del crédito desembolsado" id="id-cap-act-52a7a161682b43029f3b49410d3efbf6"/>
    <element xsi:type="archimate:Capability" name="✓ Legalización y carga de pagarés al sistema" id="id-cap-act-c3225b5536a444d5a8f8f9682a7482e6"/>
    <element xsi:type="archimate:ValueStream" name="6. Seguimiento y cobranza" id="id-vs-m-164abe7f8a16401eab072d7447eac062">
      <documentation>Monitoreo continuo del comportamiento de pago, emisión de notificaciones de cobranza (preventivas y en domicilio para mora crítica ~4 meses), gestión de renovaciones/acuerdos por incapacidad de pago y cálculo automatizado de previsiones con retroalimentación al score crediticio.</documentation>
    </element>
    <element xsi:type="archimate:ValueStream" name="6.1 Descarga y monitoreo de cartera" id="id-vs-c-02c48706675e4c7ea5a546a930d3a441">
      <documentation>Subfase 6.1 Monitoreo de cartera | Actividades: Descarga diaria de cartera, Filtrado por asesor/riesgo/días de mora (identificación de atrasos críticos ~4 meses), Emisión de alertas y notificaciones de cobranza | Entregable: Cartera filtrada y notificaciones emitidas</documentation>
    </element>
    <element xsi:type="archimate:Capability" name="F6.1 Descarga, Filtrado y Notificación de Cartera" id="id-cap-f-741013dd6f934f41964933ad731379e6">
      <documentation>Descarga diaria y filtrado automatizado de cartera para los 4 asesores según calificación de riesgo y días de vencimiento (identificando socios que acumulan hasta ~4 meses sin pagar). Incluye la capacidad de emisión de notificaciones de cobranza y recordatorios preventivos en articulación con otro proyecto de la cooperativa (iniciativa Chatbot PJL), manteniendo en este mapa la capacidad de negocio sin atarla a una implementación tecnológica específica.</documentation>
    </element>
    <element xsi:type="archimate:Capability" name="✓ Automatización de descarga diaria de cartera (4 asesores)" id="id-cap-act-021b3b5fae0844219fec4f1cf8bc5e30"/>
    <element xsi:type="archimate:Capability" name="✓ Filtrado automático por asesor, calificación de riesgo y días de vencimiento" id="id-cap-act-aba47db7739b47f889a3c111ad48a3e1"/>
    <element xsi:type="archimate:Capability" name="✓ Emisión de alertas y notificaciones de cobranza (sinergia proyecto externo)" id="id-cap-act-61c39a84d20148b891c4e5b27109a111"/>
    <element xsi:type="archimate:ValueStream" name="6.2 Gestión de cobranza y visitas" id="id-vs-c-131be64ef73b45c792cd845df34f2d42">
      <documentation>Subfase 6.2 Gestión de cobranza y visitas | Actividades: Notificación presencial en domicilio (mora ~4 meses), Evaluación de renovaciones/reestructuración por incapacidad de pago, Gestión de recaudo y cobranza extrajudicial/judicial | Entregable: Recuperación o renovación</documentation>
    </element>
    <element xsi:type="archimate:Capability" name="F6.2 Notificación en Territorio, Renovaciones y Recuperación" id="id-cap-f-83b5e1b3fd6f46839a336f60de49f2e2">
      <documentation>Levantamiento en campo junto al personal de la cooperativa (PJL): cuando los socios acumulan alrededor de 4 meses sin cancelar sus cuotas, se realiza el acompañamiento y entrega de notificaciones de cobranza en el domicilio del deudor. Práctica actual de la cooperativa: gestionar renovaciones (novación/refinanciamiento/reestructuración conectada con la subfase 5.2) para socios que no pueden cubrir su deuda vigente. Propuestas levantadas en la zona (nivel conceptual): habilitar la facilidad de pago directo a partir de la notificación y disponer de un mecanismo/cuenta dedicada para canalizar la recaudación de cobranza.</documentation>
    </element>
    <element xsi:type="archimate:Capability" name="✓ Notificación de cobranza en domicilio y seguimiento de mora (~2 meses)" id="id-cap-act-f735c27d48c64f7983ad29096a68659a"/>
    <element xsi:type="archimate:Capability" name="✓ Gestión de renovaciones y acuerdos para socios sin capacidad de pago" id="id-cap-act-db21bf02e1c240c396499ac6d2296e96"/>
    <element xsi:type="archimate:Capability" name="✓ Facilitación de recaudo en notificación y cobranza extrajudicial / judicial" id="id-cap-act-4e570014eba540c8a85d56fcff092b97"/>
    <element xsi:type="archimate:ValueStream" name="6.3 Previsiones y reportes diarios" id="id-vs-c-e1ddfeb28a3748fc875c675c52a858d9">
      <documentation>Subfase 6.3 Previsiones y retroalimentación al score | Actividades: Cálculo automatizado de previsiones, Reportes diarios de gestión y pérdida esperada, Retroalimentación de mora y renovaciones al modelo de score crediticio | Entregable: Provisión y score actualizado</documentation>
    </element>
    <element xsi:type="archimate:Capability" name="F6.3 Automatización de Previsiones y Retroalimentación al Score" id="id-cap-f-3b06588a9ad742d0a25c1ad422d6e4b0">
      <documentation>Automatización del cálculo de previsiones contables y reportes diarios de cartera (eliminando hojas de cálculo manuales), e integración de los resultados de cobranza (días de mora acumulados, notificaciones entregadas y renovaciones por incapacidad de pago) para retroalimentar y automatizar aún más el cálculo del score crediticio del socio en futuras evaluaciones.</documentation>
    </element>
    <element xsi:type="archimate:Capability" name="✓ Cálculo automatizado de previsiones (sin hojas de cálculo)" id="id-cap-act-500199c516314acfb58732288e490253"/>
    <element xsi:type="archimate:Capability" name="✓ Generación automática de reportes diarios de gestión y pérdida esperada" id="id-cap-act-9ecb64d1f70944d6a7fb7f236a9e3cd4"/>
    <element xsi:type="archimate:Capability" name="✓ Retroalimentación de mora, notificaciones y renovaciones al score crediticio" id="id-cap-act-72d48b95e31249c7a2d5f6c38210b222"/>
