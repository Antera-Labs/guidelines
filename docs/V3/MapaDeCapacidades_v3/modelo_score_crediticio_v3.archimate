    <element xsi:type="archimate:Capability" name="✓ Imputación de valores faltantes" id="id-cap-act-791fc9feeff144d3960548c7dd755344"/>
    <element xsi:type="archimate:Capability" name="✓ Normalización y estandarización de variables" id="id-cap-act-bc0c2f1cf7c249be8b74f34c619cf419"/>
    <element xsi:type="archimate:ValueStream" name="3. Evaluación y cálculo del score" id="id-vs-m-3901a4a287d44ea08e41cf9313cf5f00">
      <documentation>Aplicación de filtros de política (knock-out), análisis financiero de capacidad de pago, inferencia del modelo estadístico/ML y segmentación de riesgo.</documentation>
    </element>
    <element xsi:type="archimate:Capability" name="3.1 Filtros de política (knock-out)" id="id-cap-c-6f26b6e48c264b16b00850935942f946">
      <documentation>Subfase 3.1 Filtros de política (knock-out) | Actividades: Validación de edad y capacidad mínima, Verificación de mora vigente, Control de umbral de sobreendeudamiento | Entregable: Aprobado / rechazado previo</documentation>
    </element>
    <element xsi:type="archimate:Capability" name="F3.1 Motor de Reglas y Filtros Knock-Out" id="id-cap-f-b3542f428e954e52bb7c2d02f7cacab2"/>
    <element xsi:type="archimate:Capability" name="✓ Validación de edad y capacidad mínima" id="id-cap-act-0173d7a8660f483b98cbc28bc227b3c8"/>
    <element xsi:type="archimate:Capability" name="✓ Verificación de mora vigente" id="id-cap-act-283e67e85f8845e9aaff5932b3ae1ceb"/>
    <element xsi:type="archimate:Capability" name="✓ Control de umbral de sobreendeudamiento" id="id-cap-act-ba4c7888bc9344f7a5fe831ecf59a3c8"/>
    <element xsi:type="archimate:Capability" name="3.2 Análisis de capacidad de pago" id="id-cap-c-5639cbc433954d4ca5b1d60d632465a1">
      <documentation>Subfase 3.2 Análisis de capacidad de pago | Actividades: Cálculo de ratio cuota / ingreso, Evaluación de nivel de endeudamiento, Determinación de flujo de caja disponible | Entregable: Indicadores financieros</documentation>
    </element>
    <element xsi:type="archimate:Capability" name="F3.2 Cálculo de Indicadores Financieros" id="id-cap-f-084930e043694d1491b944079634ef8c"/>
    <element xsi:type="archimate:Capability" name="✓ Cálculo de ratio cuota / ingreso" id="id-cap-act-97350b1bf0d2407bb52d15b3f43ededf"/>
    <element xsi:type="archimate:Capability" name="✓ Evaluación de nivel de endeudamiento" id="id-cap-act-24b9ec58eff74659b2482f9918c1da7d"/>
    <element xsi:type="archimate:Capability" name="✓ Determinación de flujo de caja disponible" id="id-cap-act-4081db8f17a7407988d3d82293791b3f"/>
    <element xsi:type="archimate:Capability" name="3.3 Aplicación del modelo" id="id-cap-c-48dc4d6b997b483a8e5d209b8bb4ff54">
      <documentation>Subfase 3.3 Aplicación del modelo | Actividades: Inferencia por regresión logística / ML, Cálculo de probabilidad de default (PD), Transformación a puntaje crediticio (Score) | Entregable: Puntaje (score)</documentation>
    </element>
    <element xsi:type="archimate:Capability" name="F3.3 Ejecución del Modelo de Scoring" id="id-cap-f-2a125a9c6494430e881f804692d20e94"/>
