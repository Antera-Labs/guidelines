    <element xsi:type="archimate:ValueStream" name="6.3 Provisiones" id="id-vs-c-e1ddfeb28a3748fc875c675c52a858d9">
      <documentation>Subfase 6.3 Provisiones | Actividades: Estimación de parámetros PD, LGD y EAD, Cálculo de pérdida esperada (PD × LGD × EAD) | Entregable: Provisión contable</documentation>
    </element>
    <element xsi:type="archimate:Capability" name="F6.3 Motor de Cálculo de Provisiones" id="id-cap-f-3b06588a9ad742d0a25c1ad422d6e4b0"/>
