    <element xsi:type="archimate:ValueStream" name="5. Formalización y desembolso" id="id-vs-m-65e44d2994144ce09f76bc1825b1a808">
      <documentation>Instrumentación contractual con el cliente, constitución de garantías y acreditación efectiva de los fondos.</documentation>
    </element>
    <element xsi:type="archimate:ValueStream" name="5.1 Aceptación del cliente" id="id-vs-c-08637f98964548c58c8d77e6c109ec14">
      <documentation>Subfase 5.1 Aceptación del cliente | Actividades: Firma de contrato y pagaré, Constitución formal de garantías | Entregable: Contrato firmado</documentation>
    </element>
    <element xsi:type="archimate:Capability" name="F5.1 Instrumentación y Formalización Legal" id="id-cap-f-582bd3c4ffb645e3a6627e1396ae145c"/>
    <element xsi:type="archimate:Capability" name="✓ Firma de contrato y pagaré" id="id-cap-act-ef368b65b32c401d82eff4b1d206de14"/>
    <element xsi:type="archimate:Capability" name="✓ Constitución formal de garantías" id="id-cap-act-cc7de652e1294e80a78e9e784e05481e"/>
    <element xsi:type="archimate:ValueStream" name="5.2 Desembolso" id="id-vs-c-5ddeb091a3bb47ccba260af08fe5a7f8">
      <documentation>Subfase 5.2 Desembolso | Actividades: Acreditación de fondos en cuenta, Generación de tabla de amortización | Entregable: Crédito activo</documentation>
    </element>
    <element xsi:type="archimate:Capability" name="F5.2 Liquidación y Activación del Crédito" id="id-cap-f-31df4646a9f84a5cb612b1bcc142f86e"/>
    <element xsi:type="archimate:Capability" name="✓ Acreditación de fondos en cuenta" id="id-cap-act-ea8d33c3d8164288b74d503988764ffd"/>
    <element xsi:type="archimate:Capability" name="✓ Generación de tabla de amortización" id="id-cap-act-f9670b19d2554e5fb7ac5ff117272be3"/>
    <element xsi:type="archimate:ValueStream" name="6. Seguimiento y cobranza" id="id-vs-m-164abe7f8a16401eab072d7447eac062">
      <documentation>Monitoreo continuo del comportamiento de pago, gestión escalonada de cobranza y cálculo de provisiones por pérdida esperada.</documentation>
    </element>
    <element xsi:type="archimate:ValueStream" name="6.1 Monitoreo de cartera" id="id-vs-c-02c48706675e4c7ea5a546a930d3a441">
      <documentation>Subfase 6.1 Monitoreo de cartera | Actividades: Ejecución de score de comportamiento, Emisión de alertas tempranas de deterioro | Entregable: Reporte de cartera</documentation>
    </element>
    <element xsi:type="archimate:Capability" name="F6.1 Seguimiento Comportamental de Cartera" id="id-cap-f-741013dd6f934f41964933ad731379e6"/>
    <element xsi:type="archimate:Capability" name="✓ Ejecución de score de comportamiento" id="id-cap-act-021b3b5fae0844219fec4f1cf8bc5e30"/>
    <element xsi:type="archimate:Capability" name="✓ Emisión de alertas tempranas de deterioro" id="id-cap-act-aba47db7739b47f889a3c111ad48a3e1"/>
    <element xsi:type="archimate:ValueStream" name="6.2 Gestión de cobranza" id="id-vs-c-131be64ef73b45c792cd845df34f2d42">
      <documentation>Subfase 6.2 Gestión de cobranza | Actividades: Gestión de cobranza preventiva, Gestión de cobranza temprana, Gestión de cobranza judicial | Entregable: Recuperación</documentation>
    </element>
