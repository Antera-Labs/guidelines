      <documentation>Subfase 4.2 Revisión manual / comité | Actividades: Análisis de casos en zona gris, Evaluación y fallo para montos altos | Entregable: Resolución del comité</documentation>
    </element>
    <element xsi:type="archimate:Capability" name="F4.2 Gestión de Comité de Crédito" id="id-cap-f-bb11c46e759d494fade51251376983c3"/>
    <element xsi:type="archimate:Capability" name="✓ Análisis de casos en zona gris" id="id-cap-act-101a901916114bd196eeb4ffd073de5f"/>
