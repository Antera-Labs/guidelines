    <element xsi:type="archimate:Capability" name="7.2 Monitoreo de estabilidad" id="id-cap-c-04e916e3b2064e1bbfd153fbc3483552">
      <documentation>Subfase 7.2 Monitoreo de estabilidad | Actividades: Cálculo de índice de estabilidad poblacional (PSI), Detección de deriva de variables (Data Drift) | Entregable: Alertas de deterioro</documentation>
    </element>
    <element xsi:type="archimate:Capability" name="F7.2 Control de Estabilidad y Drift" id="id-cap-f-7d7424360a4f4b8ca6a1948041c5aafd"/>
