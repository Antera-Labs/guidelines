<?xml version="1.0" encoding="UTF-8"?>
<archimate:model xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:archimate="http://www.archimatetool.com/archimate" name="Proceso de Score Crediticio Bancario (Value Stream y Capability)" id="id-model-7dc0911fb7b046a4874bc4f8dfd4f348" version="5.0.0">
  <folder name="Strategy" id="id-folder-797733b5aa1f4926a9f5c426f7739759" type="strategy">
    <element xsi:type="archimate:ValueStream" name="1. Solicitud y captación" id="id-vs-m-6245e3e228034578b9a9f8fd429ecf48">
      <documentation>Fase inicial de originación crediticia: recepción de la solicitud, validación KYC/PLA-FT y conformación del expediente digital.</documentation>
    </element>
    <element xsi:type="archimate:ValueStream" name="1.1 Recepción de solicitud" id="id-vs-c-2250ace556ce488983ff92e784531833">
      <documentation>Subfase 1.1 Recepción de solicitud | Actividades: Registro de datos del cliente, Definición de monto y plazo, Registro de destino del crédito | Entregable: Solicitud registrada</documentation>
    </element>
    <element xsi:type="archimate:Capability" name="F1.1 Recepción y Registro de Solicitud" id="id-cap-f-00e10df0edc7452a8cfa29a01d2f7860"/>
    <element xsi:type="archimate:Capability" name="✓ Registro de datos del cliente" id="id-cap-act-730760cf12a043d2b205252efa140cfa"/>
    <element xsi:type="archimate:Capability" name="✓ Definición de monto y plazo" id="id-cap-act-5144f5f7f8694654986d780acfb45595"/>
    <element xsi:type="archimate:Capability" name="✓ Registro de destino del crédito" id="id-cap-act-bb16019025de47aca6de61855d9186a0"/>
    <element xsi:type="archimate:ValueStream" name="1.2 Validación de identidad (KYC)" id="id-vs-c-bc3b394aef334596848ded7f6cce436a">
      <documentation>Subfase 1.2 Validación de identidad (KYC) | Actividades: Verificación de cédula de identidad, Validación biométrica del solicitante, Consulta en listas restrictivas (PLA/FT) | Entregable: Cliente validado</documentation>
    </element>
    <element xsi:type="archimate:Capability" name="F1.2 Validación de Identidad y Cumplimiento" id="id-cap-f-4cfa1c4bc9074e5aa3bc99f0c9aaecec"/>
    <element xsi:type="archimate:Capability" name="✓ Verificación de cédula de identidad" id="id-cap-act-801ba336befa4d25b9b356af82880323"/>
    <element xsi:type="archimate:Capability" name="✓ Validación biométrica del solicitante" id="id-cap-act-c7dd037f3a554def923044d7b0ba2831"/>
    <element xsi:type="archimate:Capability" name="✓ Consulta en listas restrictivas (PLA/FT)" id="id-cap-act-e3e46d5393874bc29a3b31731a2a66bc"/>
    <element xsi:type="archimate:ValueStream" name="1.3 Recolección documental" id="id-vs-c-5d04de6a3f0a4002862c54d7546f3596">
      <documentation>Subfase 1.3 Recolección documental | Actividades: Recolección de ingresos y roles de pago, Recepción de declaraciones tributarias, Registro de respaldos y garantías | Entregable: Expediente digital</documentation>
    </element>
    <element xsi:type="archimate:Capability" name="F1.3 Digitalización y Carga Documental" id="id-cap-f-d4b32a9601a54525ab76a04cedc14937"/>
    <element xsi:type="archimate:Capability" name="✓ Recolección de ingresos y roles de pago" id="id-cap-act-954d55e6fad84de9a476881081404601"/>
    <element xsi:type="archimate:Capability" name="✓ Recepción de declaraciones tributarias" id="id-cap-act-34aedd479c9849f7baf3db75e797c6e5"/>
    <element xsi:type="archimate:Capability" name="✓ Registro de respaldos y garantías" id="id-cap-act-fec608d88fb0484d9877f5c23868c633"/>
    <element xsi:type="archimate:ValueStream" name="2. Recolección y consolidación de datos" id="id-vs-m-12e389bda3d64cf8af337d0ff6e456f5">
      <documentation>Integración de fuentes internas de la entidad y fuentes externas (buró y central de riesgos SB/SEPS) en un dataset depurado.</documentation>
    </element>
    <element xsi:type="archimate:ValueStream" name="2.1 Validación de Datos internos" id="id-vs-c-7c6bb75b202c42f584a36cc9dd4dd77d">
      <documentation>Subfase 2.1 Datos internos | Actividades: Consulta de historial con la entidad, Evaluación de saldos y ahorros, Análisis de comportamiento de pago interno | Entregable: Perfil interno</documentation>
    </element>
    <element xsi:type="archimate:Capability" name="F2.1 Extracción de Datos Internos" id="id-cap-f-240af738c09640968b5c1574a4cbc9a3"/>
    <element xsi:type="archimate:Capability" name="✓ Consulta de historial con la entidad" id="id-cap-act-e33466cdf3ef424691a0fe2ed3a6e390"/>
    <element xsi:type="archimate:Capability" name="✓ Evaluación de saldos y ahorros" id="id-cap-act-ec8f4255daf347a4b068d179a40fd95f"/>
    <element xsi:type="archimate:Capability" name="✓ Análisis de comportamiento de pago interno" id="id-cap-act-4da6586d4652437ca9345502d410e949"/>
    <element xsi:type="archimate:ValueStream" name="2.2 Vaidación de Datos externos" id="id-vs-c-3353f6f79e84446d8c9d4598f41a0882">
      <documentation>Subfase 2.2 Datos externos | Actividades: Consulta a buró de crédito, Consulta a central de riesgos (SB/SEPS) | Entregable: Reporte de buró</documentation>
    </element>
    <element xsi:type="archimate:Capability" name="F2.2 Consulta a Fuentes Externas" id="id-cap-f-c9953c75b6ac4892aa03aa1ed3d63481"/>
    <element xsi:type="archimate:Capability" name="✓ Consulta a buró de crédito" id="id-cap-act-a7e6ecb6217e47d9b363b2ea2e8a0a16"/>
    <element xsi:type="archimate:Capability" name="✓ Consulta a central de riesgos (SB/SEPS)" id="id-cap-act-e5fbbc269ba049b5aab42d6c492e85ce"/>
    <element xsi:type="archimate:ValueStream" name="2.3 Integración y limpieza" id="id-vs-c-2cf7d7624a844f149a54a52d93bddc94">
      <documentation>Subfase 2.3 Integración y limpieza | Actividades: Depuración de registros e inconsistencias, Imputación de valores faltantes, Normalización y estandarización de variables | Entregable: Dataset consolidado</documentation>
    </element>
    <element xsi:type="archimate:Capability" name="F2.3 Integración, Limpieza y Normalización" id="id-cap-f-97438cdfc08149efb8d90a259e6839a7"/>
    <element xsi:type="archimate:Capability" name="✓ Depuración de registros e inconsistencias" id="id-cap-act-072377cbc821404c9272826b1c65bd02"/>
    <element xsi:type="archimate:Capability" name="✓ Imputación de valores faltantes" id="id-cap-act-136e595ae3314a55932f97a70550063a"/>
    <element xsi:type="archimate:Capability" name="✓ Normalización y estandarización de variables" id="id-cap-act-f46c9dd857b242648f631386fb89309b"/>
    <element xsi:type="archimate:ValueStream" name="3. Evaluación y cálculo del score" id="id-vs-m-a7b0bcb66c974e22a34d1bf541ae8dce">
      <documentation>Aplicación de filtros de política (knock-out), análisis financiero de capacidad de pago, inferencia del modelo estadístico/ML y segmentación de riesgo.</documentation>
    </element>
    <element xsi:type="archimate:ValueStream" name="3.1 Filtros de política (knock-out)" id="id-vs-c-f2c73997764e48d4a250e224575a9301">
      <documentation>Subfase 3.1 Filtros de política (knock-out) | Actividades: Validación de edad y capacidad mínima, Verificación de mora vigente, Control de umbral de sobreendeudamiento | Entregable: Aprobado / rechazado previo</documentation>
    </element>
    <element xsi:type="archimate:Capability" name="F3.1 Motor de Reglas y Filtros Knock-Out" id="id-cap-f-8cd046037b2843f3ab21fd18e36a9069"/>
    <element xsi:type="archimate:Capability" name="✓ Validación de edad y capacidad mínima" id="id-cap-act-931ea0c924ee45c69169d12301ddf121"/>
    <element xsi:type="archimate:Capability" name="✓ Verificación de mora vigente" id="id-cap-act-a2133744529049099d198c8ff4fe1081"/>
    <element xsi:type="archimate:Capability" name="✓ Control de umbral de sobreendeudamiento" id="id-cap-act-3e27963b0bf34642822fa84ab5be3cb2"/>
    <element xsi:type="archimate:ValueStream" name="3.2 Análisis de capacidad de pago" id="id-vs-c-ba08d3271b7141bdb22cf1e462efc156">
      <documentation>Subfase 3.2 Análisis de capacidad de pago | Actividades: Cálculo de ratio cuota / ingreso, Evaluación de nivel de endeudamiento, Determinación de flujo de caja disponible | Entregable: Indicadores financieros</documentation>
    </element>
    <element xsi:type="archimate:Capability" name="F3.2 Cálculo de Indicadores Financieros" id="id-cap-f-8d8ca029fe884b97a3cf178ce2fc61f4"/>
    <element xsi:type="archimate:Capability" name="✓ Cálculo de ratio cuota / ingreso" id="id-cap-act-139a767d13254d8594a3a51c52559a6b"/>
    <element xsi:type="archimate:Capability" name="✓ Evaluación de nivel de endeudamiento" id="id-cap-act-022f8c58dc254882a6a2f407955c29ef"/>
    <element xsi:type="archimate:Capability" name="✓ Determinación de flujo de caja disponible" id="id-cap-act-84d33ea3bc3d47e9964d63f960ab0311"/>
    <element xsi:type="archimate:ValueStream" name="3.3 Aplicación del modelo" id="id-vs-c-f6500b33cc7e41c4b50e703017a20e6e">
      <documentation>Subfase 3.3 Aplicación del modelo | Actividades: Inferencia por regresión logística / ML, Cálculo de probabilidad de default (PD), Transformación a puntaje crediticio (Score) | Entregable: Puntaje (score)</documentation>
    </element>
    <element xsi:type="archimate:Capability" name="F3.3 Ejecución del Modelo de Scoring" id="id-cap-f-9671ddf37a814bf1b24b1027eb912288"/>
    <element xsi:type="archimate:Capability" name="✓ Inferencia por regresión logística / ML" id="id-cap-act-f105da24f7904893b5a82174017f096c"/>
    <element xsi:type="archimate:Capability" name="✓ Cálculo de probabilidad de default (PD)" id="id-cap-act-c8a82b76bcae42c9a623076d6fa5dc90"/>
    <element xsi:type="archimate:Capability" name="✓ Transformación a puntaje crediticio (Score)" id="id-cap-act-ca605c71ee3645fe866030dfa75763f0"/>
    <element xsi:type="archimate:ValueStream" name="3.3 Segmentación de riesgo" id="id-vs-c-9b553351e334424598622e866af64599">
      <documentation>Subfase 3.4 Segmentación de riesgo | Actividades: Evaluación de puntos de corte (cut-offs), Asignación a categoría de riesgo (A, B, C, D, E) | Entregable: Calificación de riesgo</documentation>
    </element>
    <element xsi:type="archimate:Capability" name="F3. Clasificación y Rating de Riesgo" id="id-cap-f-55fe56d7a8f64838be52f1058dffbdd2"/>
    <element xsi:type="archimate:Capability" name="✓ Evaluación de puntos de corte (cut-offs)" id="id-cap-act-51442dd1f5e44a819b33fa8d249e677a"/>
