    <element xsi:type="archimate:ValueStream" name="4.3 Definición de condiciones" id="id-vs-c-fe24b5b4e17d48a187ab77d4af8c2f91">
      <documentation>Subfase 4.3 Definición de condiciones | Actividades: Asignación de tasa de interés según riesgo, Definición de plazo y cupo aprobado, Establecimiento de garantías requeridas | Entregable: Oferta crediticia</documentation>
    </element>
