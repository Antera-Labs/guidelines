    <element xsi:type="archimate:Capability" name="7.3 Recalibración" id="id-cap-c-d7b4a575940f4630b706cf3d4dfdcaed">
      <documentation>Subfase 7.3 Recalibración | Actividades: Reentrenamiento del modelo de scoring, Validación y aprobación regulatoria | Entregable: Nueva versión del modelo</documentation>
    </element>
    <element xsi:type="archimate:Capability" name="F7.3 Reentrenamiento y Aprobación Regulatoria" id="id-cap-f-22ec31bc02d64f0d9307fc5bef73b8c3"/>
