    <element xsi:type="archimate:Capability" name="4.2 Revisión manual / comité" id="id-cap-c-ea4b1081b4dd4a9892d29a809d6026d9">
      <documentation>Subfase 4.2 Revisión manual / comité | Actividades: Análisis de casos en zona gris, Evaluación y fallo para montos altos | Entregable: Resolución del comité</documentation>
    </element>
    <element xsi:type="archimate:Capability" name="F4.2 Gestión de Comité de Crédito" id="id-cap-f-7bc4652da12a42088e0aacb8b379b32d"/>
    <element xsi:type="archimate:Capability" name="✓ Análisis de casos en zona gris" id="id-cap-act-36d6e14ab6f341928b3e2c45f329b9e1"/>
    <element xsi:type="archimate:Capability" name="✓ Evaluación y fallo para montos altos" id="id-cap-act-a9876d9f7d18423fbeb2569edf784403"/>
