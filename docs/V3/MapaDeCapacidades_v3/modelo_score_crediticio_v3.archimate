    <element xsi:type="archimate:Capability" name="✓ Transformación a puntaje crediticio (Score)" id="id-cap-act-e0767231905f43f3a5d68bede39e56e6"/>
    <element xsi:type="archimate:Capability" name="3.4 Segmentación de riesgo" id="id-cap-c-e9195545607d46aaa539b94e13f0796d">
      <documentation>Subfase 3.4 Segmentación de riesgo | Actividades: Evaluación de puntos de corte (cut-offs), Asignación a categoría de riesgo (A, B, C, D, E) | Entregable: Calificación de riesgo</documentation>
    </element>
    <element xsi:type="archimate:Capability" name="F3.4 Clasificación y Rating de Riesgo" id="id-cap-f-1d406804b88143df95202c10dccafccf"/>
    <element xsi:type="archimate:Capability" name="✓ Evaluación de puntos de corte (cut-offs)" id="id-cap-act-3e612873e4d34d83ba4238b6db69d628"/>
    <element xsi:type="archimate:Capability" name="✓ Asignación a categoría de riesgo (A, B, C, D, E)" id="id-cap-act-1e8e274b05224af197e75b35f4c76df5"/>
    <element xsi:type="archimate:ValueStream" name="4. Decisión crediticia" id="id-vs-m-ad2537bff9bf4d0ba3a64e054c053b20">
      <documentation>Determinación del dictamen crediticio mediante matriz automatizada, revisión por comité en zona gris y parametrización de la oferta.</documentation>
    </element>
    <element xsi:type="archimate:Capability" name="4.1 Matriz de decisión" id="id-cap-c-74fb5642616542c2a5968ea68a1867b8">
      <documentation>Subfase 4.1 Matriz de decisión | Actividades: Cruce de score vs. monto solicitado, Contrastación contra política de riesgo, Generación de dictamen automático | Entregable: Recomendación</documentation>
    </element>
    <element xsi:type="archimate:Capability" name="F4.1 Evaluación en Matriz de Decisión" id="id-cap-f-f43a0b8c88894aedb273d514d57df2a0"/>
