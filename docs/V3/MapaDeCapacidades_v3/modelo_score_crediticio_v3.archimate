    <element xsi:type="archimate:ValueStream" name="7.2 Monitoreo de estabilidad" id="id-vs-c-5b55967641e048efa87de327b8a38623">
      <documentation>Subfase 7.2 Monitoreo de estabilidad | Actividades: Cálculo de índice de estabilidad poblacional (PSI), Detección de deriva de variables (Data Drift) | Entregable: Alertas de deterioro</documentation>
    </element>
    <element xsi:type="archimate:Capability" name="F7.2 Control de Estabilidad y Drift" id="id-cap-f-17ee1d603435469090c9e9d53f64e885"/>
