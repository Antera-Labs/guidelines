    <element xsi:type="archimate:ValueStream" name="7. Mantenimiento del modelo" id="id-vs-m-f9eb8e695dd441369c96cd1f3603e235">
      <documentation>Gobierno analítico del modelo de scoring: backtesting estadístico, monitoreo de estabilidad (PSI/drift) y recalibración regulatoria.</documentation>
    </element>
    <element xsi:type="archimate:Capability" name="7.1 Backtesting y validación" id="id-cap-c-168ec6aba0da4c8480013d55473371ec">
      <documentation>Subfase 7.1 Backtesting y validación | Actividades: Cálculo de métricas KS, Gini y AUC, Evaluación de matriz de confusión | Entregable: Informe de desempeño</documentation>
    </element>
    <element xsi:type="archimate:Capability" name="F7.1 Evaluación de Desempeño Estadístico" id="id-cap-f-6ce096245d164c21981c553e4560b062"/>
