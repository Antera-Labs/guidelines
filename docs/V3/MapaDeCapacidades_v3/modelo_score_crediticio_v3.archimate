    <element xsi:type="archimate:Capability" name="✓ Gestión de cobranza judicial" id="id-cap-act-d6684b2775f2468482a610aa750737af"/>
    <element xsi:type="archimate:Capability" name="6.3 Provisiones" id="id-cap-c-68d21f655eca4562a97bf89af7128ca6">
      <documentation>Subfase 6.3 Provisiones | Actividades: Estimación de parámetros PD, LGD y EAD, Cálculo de pérdida esperada (PD × LGD × EAD) | Entregable: Provisión contable</documentation>
    </element>
    <element xsi:type="archimate:Capability" name="F6.3 Motor de Cálculo de Provisiones" id="id-cap-f-ac52f7909f0f46618c320f5219130549"/>
    <element xsi:type="archimate:Capability" name="✓ Estimación de parámetros PD, LGD y EAD" id="id-cap-act-4329034171134b7fbcd34ee76f99b936"/>
