    <element xsi:type="archimate:ValueStream" name="7.3 Recalibración" id="id-vs-c-fccc9c343ae744c38d083ad342457aa2">
      <documentation>Subfase 7.3 Recalibración | Actividades: Reentrenamiento del modelo de scoring, Validación y aprobación regulatoria | Entregable: Nueva versión del modelo</documentation>
    </element>
    <element xsi:type="archimate:Capability" name="F7.3 Reentrenamiento y Aprobación Regulatoria" id="id-cap-f-c30d77d45b1c4fbca8556ca92315667f"/>
    <element xsi:type="archimate:Capability" name="✓ Reentrenamiento del modelo de scoring" id="id-cap-act-d7ea351712a440a386707da7215acd56"/>
