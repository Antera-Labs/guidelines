    <element xsi:type="archimate:Capability" name="✓ Consulta en listas restrictivas (PLA/FT)" id="id-cap-act-db758c270d764f51bbbc90ca5e4ff09d"/>
    <element xsi:type="archimate:Capability" name="1.3 Recolección documental" id="id-cap-c-c5d00ee7e86048cabb04bb0ac06b86ab">
      <documentation>Subfase 1.3 Recolección documental | Actividades: Recolección de ingresos y roles de pago, Recepción de declaraciones tributarias, Registro de respaldos y garantías | Entregable: Expediente digital</documentation>
    </element>
    <element xsi:type="archimate:Capability" name="F1.3 Digitalización y Carga Documental" id="id-cap-f-e84a7aa59fc84bb2b765b592107d6346"/>
    <element xsi:type="archimate:Capability" name="✓ Recolección de ingresos y roles de pago" id="id-cap-act-877df3e65cf6494383c9c0c3b1a5d628"/>
    <element xsi:type="archimate:Capability" name="✓ Recepción de declaraciones tributarias" id="id-cap-act-89a8cea1332e47eebbadde15b619fd38"/>
    <element xsi:type="archimate:Capability" name="✓ Registro de respaldos y garantías" id="id-cap-act-45ccd44ab4a547928dddd3a169dfe111"/>
    <element xsi:type="archimate:ValueStream" name="2. Recolección y consolidación de datos" id="id-vs-m-9f5cb9e6168a49c89eee39bb454b4df3">
      <documentation>Integración de fuentes internas de la entidad y fuentes externas (buró y central de riesgos SB/SEPS) en un dataset depurado.</documentation>
    </element>
    <element xsi:type="archimate:Capability" name="2.1 Datos internos" id="id-cap-c-1f8c1f7a376644c08fd1512dca0e1dec">
      <documentation>Subfase 2.1 Datos internos | Actividades: Consulta de historial con la entidad, Evaluación de saldos y ahorros, Análisis de comportamiento de pago interno | Entregable: Perfil interno</documentation>
    </element>
    <element xsi:type="archimate:Capability" name="F2.1 Extracción de Datos Internos" id="id-cap-f-1dbb2e57455d4ceaaec0e19f612af077"/>
    <element xsi:type="archimate:Capability" name="✓ Consulta de historial con la entidad" id="id-cap-act-48bd96efdfba45d1af7c2becfa3b5228"/>
    <element xsi:type="archimate:Capability" name="✓ Evaluación de saldos y ahorros" id="id-cap-act-6e7e8ceccc434efba71473ebebf2274e"/>
    <element xsi:type="archimate:Capability" name="✓ Análisis de comportamiento de pago interno" id="id-cap-act-158972a744bc488e990001a8dfab4f29"/>
    <element xsi:type="archimate:Capability" name="2.2 Datos externos" id="id-cap-c-23bc1050dd4d4ed29b65ae07aac1d993">
      <documentation>Subfase 2.2 Datos externos | Actividades: Consulta a buró de crédito, Consulta a central de riesgos (SB/SEPS) | Entregable: Reporte de buró</documentation>
    </element>
    <element xsi:type="archimate:Capability" name="F2.2 Consulta a Fuentes Externas" id="id-cap-f-63847fd233214d27a6bf42e46a4d9db4"/>
    <element xsi:type="archimate:Capability" name="✓ Consulta a buró de crédito" id="id-cap-act-84a981a8f5f84116ba6498de46dd76a0"/>
    <element xsi:type="archimate:Capability" name="✓ Consulta a central de riesgos (SB/SEPS)" id="id-cap-act-bac51856649c4f3d903d9aba06f5080c"/>
    <element xsi:type="archimate:Capability" name="2.3 Integración y limpieza" id="id-cap-c-3b9356739dc34550af6d2a345badce60">
      <documentation>Subfase 2.3 Integración y limpieza | Actividades: Depuración de registros e inconsistencias, Imputación de valores faltantes, Normalización y estandarización de variables | Entregable: Dataset consolidado</documentation>
    </element>
    <element xsi:type="archimate:Capability" name="F2.3 Integración, Limpieza y Normalización" id="id-cap-f-2d5762c61d61466f86b9d14214c9c5a3"/>
