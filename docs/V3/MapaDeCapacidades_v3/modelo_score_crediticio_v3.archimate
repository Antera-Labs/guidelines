    <element xsi:type="archimate:ValueStream" name="1. Solicitud y captación" id="id-vs-m-21275b4da36f40eab3f25ef001c1f3af">
      <documentation>Fase inicial de originación crediticia: recepción de la solicitud, validación KYC/PLA-FT y conformación del expediente digital.</documentation>
    </element>
    <element xsi:type="archimate:Capability" name="1.1 Recepción de solicitud" id="id-cap-c-a178e8bc53c94252b18e184f66e712ca">
      <documentation>Subfase 1.1 Recepción de solicitud | Actividades: Registro de datos del cliente, Definición de monto y plazo, Registro de destino del crédito | Entregable: Solicitud registrada</documentation>
    </element>
    <element xsi:type="archimate:Capability" name="F1.1 Recepción y Registro de Solicitud" id="id-cap-f-ef0e58e26ea34f2ba45f7d86609acf1d"/>
    <element xsi:type="archimate:Capability" name="✓ Registro de datos del cliente" id="id-cap-act-9819872e389a4171a606b87e4efce0d3"/>
    <element xsi:type="archimate:Capability" name="✓ Definición de monto y plazo" id="id-cap-act-13ed19428e8148a8a35be923f8dfaa08"/>
    <element xsi:type="archimate:Capability" name="✓ Registro de destino del crédito" id="id-cap-act-c0e5ecee62c34972ac42c4882d3f457e"/>
    <element xsi:type="archimate:Capability" name="1.2 Validación de identidad (KYC)" id="id-cap-c-8d9565417d1748018abf8830431ce74d">
      <documentation>Subfase 1.2 Validación de identidad (KYC) | Actividades: Verificación de cédula de identidad, Validación biométrica del solicitante, Consulta en listas restrictivas (PLA/FT) | Entregable: Cliente validado</documentation>
    </element>
    <element xsi:type="archimate:Capability" name="F1.2 Validación de Identidad y Cumplimiento" id="id-cap-f-674176cc60eb4b0c9e78bd8e495be33d"/>
