# Copia este archivo a .env (en esta misma carpeta) para docker compose. Valores SOLO para desarrollo.
ORACLE_PASSWORD=PjlSys2026
PJL_DB_PASSWORD=PjlCredito2026
# 32 bytes o más. Genera uno con: openssl rand -base64 48
PJL_JWT_SECRET=desarrollo-pjl-credito-clave-jwt-hs256-solo-local-2026
# Perfil del backend: "simulador" expone core bancario, buró y nube privada simulados.
SPRING_PROFILES_ACTIVE=simulador

# ---- Opcionales (ya tienen valor por defecto en docker-compose.services.yaml) ----
# Correo saliente para «¿Olvidaste tu clave?». En desarrollo se usa Mailpit (http://localhost:8025).
# PJL_SMTP_HOST=correo
# PJL_SMTP_PORT=1025
# Dirección pública de la web: el enlace del correo apunta a <PJL_WEB_URL>/restablecer
# PJL_WEB_URL=http://localhost:8081
