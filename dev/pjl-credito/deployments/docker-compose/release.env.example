# PJL Crédito · variables de un release. En el zip del release este archivo se llama .env.example:
# cópialo a .env y complétalo. Las vacías obligatorias detienen docker compose hasta que tengan valor.
# Nunca subas el .env con valores reales al repositorio.

# Registro de imágenes (otro si la IaaS usa un espejo interno) y versión. PJL_VERSION ya viene
# fijada en el Compose del release; defínela aquí solo para cambiar de versión.
# PJL_REGISTRO=ghcr.io/antera-labs
# PJL_VERSION=

SPRING_PROFILES_ACTIVE=

# Oracle de la cooperativa
PJL_DB_URL=
PJL_DB_USER=
PJL_DB_PASSWORD=

# 32 bytes o más. Genera uno con: openssl rand -base64 48
PJL_JWT_SECRET=

# Orígenes permitidos de la web y la app, separados por coma (https://…)
PJL_CORS=

# Integraciones
PJL_CORE_URL=
PJL_EXTERNOS_URL=
PJL_NUBE_URL=

# Correo saliente (recuperación de clave)
PJL_SMTP_HOST=
PJL_SMTP_PORT=
PJL_SMTP_USUARIO=
PJL_SMTP_CLAVE=
# PJL_SMTP_AUTH=true
# PJL_SMTP_TLS=true
PJL_CORREO_REMITENTE=

# Dirección pública de la web: el enlace del correo apunta a <PJL_WEB_URL>/restablecer
PJL_WEB_URL=
