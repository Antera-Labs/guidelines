#!/usr/bin/env bash
# PJL Crédito · pre-push. Hook de Git plano: se activa con `make hooks`.
# Si los commits que se suben tocan el proyecto, corre las pruebas de core-api.
set -euo pipefail
PROY="$(cd "$(dirname "$0")/.." && pwd)"
TOP="$(git rev-parse --show-toplevel)"
PRE="$(realpath --relative-to="$TOP" "$PROY")"
[ "$PRE" = "." ] && PRE=""

toca=0
while read -r _ref_local sha_local _ref_remota sha_remota; do
  [[ "$sha_local" =~ ^0+$ ]] && continue            # borrado de rama: nada que probar
  if [[ "$sha_remota" =~ ^0+$ ]]; then
    commits=$(git -C "$TOP" rev-list "$sha_local" --not --remotes)
  else
    commits=$(git -C "$TOP" rev-list "$sha_remota..$sha_local")
  fi
  for c in $commits; do
    if [ -n "$(git -C "$TOP" diff-tree --no-commit-id --name-only -r "$c" -- "${PRE:-.}")" ]; then
      toca=1; break
    fi
  done
done

[ "$toca" -eq 0 ] && exit 0
echo "PJL Crédito · pre-push: pruebas de core-api"
exec "$PROY/scripts/run-tests.sh" api
