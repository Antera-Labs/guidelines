#!/usr/bin/env bash
# PJL Crédito · pre-commit. Hook de Git plano (sin Husky ni npm): se activa con `make hooks`.
# Solo actúa si el commit toca archivos del proyecto (el repo Git puede contener otros proyectos).
set -euo pipefail
PROY="$(cd "$(dirname "$0")/.." && pwd)"
TOP="$(git rev-parse --show-toplevel)"
PRE="$(realpath --relative-to="$TOP" "$PROY")"
[ "$PRE" = "." ] && PRE=""

mapfile -t cambios < <(git -C "$TOP" diff --cached --name-only --diff-filter=ACMR -- "${PRE:-.}")
[ "${#cambios[@]}" -eq 0 ] && exit 0
echo "PJL Crédito · pre-commit (${#cambios[@]} archivos del proyecto)"
fallo=0

# 1. Solo se versiona .env.example; los .env reales nunca.
for f in "${cambios[@]}"; do
  case "$(basename "$f")" in
    .env.example) ;;
    .env|.env.*) echo "  ✗ No se versiona $f (solo .env.example)"; fallo=1 ;;
  esac
done

# 2. assets/tokens.css es la fuente única: las copias de las apps deben ser idénticas.
for copia in src/UIs/web/src/styles/tokens.css src/UIs/movil/src/estilos/tokens.css; do
  if ! cmp -s "$PROY/assets/tokens.css" "$PROY/$copia"; then
    echo "  ✗ $copia difiere de assets/tokens.css (cópialo desde la fuente)"; fallo=1
  fi
done

# 3. Si cambió el despliegue, el Compose debe seguir siendo válido.
if printf '%s\n' "${cambios[@]}" | grep -q "deployments/docker-compose/" && command -v docker >/dev/null 2>&1; then
  docker compose -f "$PROY/deployments/docker-compose/docker-compose.yaml" config -q \
    || { echo "  ✗ deployments/docker-compose no es válido"; fallo=1; }
fi

# 4. Formato de las apps: solo revisa, no reescribe lo que vas a commitear.
#    Usa el Prettier instalado en cada app (npm ci); si no está, avisa y sigue,
#    porque el CI (format:check) lo revisa igual.
#    El prefijo sale de git (--show-prefix) y no de $PRE: en Git Bash de Windows
#    show-toplevel da C:/… y pwd /c/…, y realpath devuelve una ruta absoluta.
prefijo="$(git -C "$PROY" rev-parse --show-prefix)"
for app in web movil; do
  base="${prefijo}src/UIs/$app/"
  archivos=()
  for f in "${cambios[@]}"; do
    [[ "$f" == "$base"* ]] && archivos+=("${f#"$base"}")
  done
  [ "${#archivos[@]}" -eq 0 ] && continue
  prettier="$PROY/src/UIs/$app/node_modules/.bin/prettier"
  if [ ! -x "$prettier" ]; then
    echo "  ! src/UIs/$app: sin node_modules, no se revisa el formato (corre npm ci en la app)"
    continue
  fi
  # --ignore-unknown: binarios y archivos sin parser de Prettier no cuentan como error.
  if ! (cd "$PROY/src/UIs/$app" && "$prettier" --check --ignore-unknown --log-level=warn "${archivos[@]}"); then
    echo "  ✗ src/UIs/$app tiene archivos sin formato: cd src/UIs/$app && npm run format"; fallo=1
  fi
done

[ "$fallo" -eq 0 ] && echo "  ✓ listo"
exit "$fallo"
